  },
  "keywords": [
    "solana",
    "helius",
    "mcp",
    "wallet",
    "security"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
