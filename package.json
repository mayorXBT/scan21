{
  "name": "scan21",
  "version": "1.0.0",
  "description": "MCP server for Helius Parsed Events Scan: wallet history, exposure audit, and outflow tracing.",
  "type": "module",
  "bin": {
    "scan21": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "probe-filters": "tsx scripts/probe-filters.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "mayorXBT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayorXBT/scan21.git"
  },
  "homepage": "https://github.com/mayorXBT/scan21",
  "bugs": {
